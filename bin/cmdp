#!/usr/bin/env bash
# Launcher for the Go cmdp binary. CI and local dev build bin/.cmdp-bin;
# install.sh copies a release asset to ~/.local/bin/cmdp.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROG="${CP_BIN:-$ROOT/bin/.cmdp-bin}"
# Clone-and-go: no local Go build, but install.sh fetched a release binary.
if [[ ! -x "$PROG" ]]; then
  RELEASE="${CP_BIN_DIR:-$HOME/.local/bin}/cmdp"
  # Guard against pointing at this launcher instead of the CLI.
  if [[ -x "$RELEASE" && ! "$RELEASE" -ef "${BASH_SOURCE[0]}" ]] &&
    [[ "$(head -c 2 "$RELEASE")" != '#!' ]]; then
    PROG="$RELEASE"
  fi
fi
if [[ ! -x "$PROG" ]]; then
  printf '[cmdp] error: cmdp binary not found at %s\n' "$PROG" >&2
  printf '[cmdp] hint: go build -ldflags="-X github.com/0xb1ob/command-post/internal/cmdp.Version=dev" -o bin/.cmdp-bin ./cmd/cmdp\n' >&2
  printf '[cmdp] hint: or run bin/install.sh to fetch a release binary\n' >&2
  exit 2
fi
# The release binary infers home from its own path (~/.local/bin/cmdp -> ~/.local).
# This launcher knows the real checkout root; pass it through.
export CP_HOME="${CP_HOME:-$ROOT}"
exec "$PROG" "$@"
